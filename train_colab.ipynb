   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 👁️ AI-Based Cataract Clinical Decision Support System (CDSS)\n",
    "## ResNet-50 Deep Learning Training Notebook on Google Colab (Free T4 GPU)\n",
    "\n",
    "This notebook downloads the **ODIR-5K** dataset, builds a PyTorch **ResNet-50** transfer learning model, trains for 10 epochs, and downloads `cataract_model_weights.pth` directly to your computer."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1: Check GPU Acceleration & Install Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q kagglehub pillow pandas torchvision scikit-learn\n",
    "\n",
    "import os\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "from torch.utils.data import DataLoader, Dataset\n",
    "from torchvision import transforms, models\n",
    "from PIL import Image\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f\"[*] Hardware Device: {device}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"[*] Accelerated GPU: {torch.cuda.get_device_name(0)}\")\n",
    "else:\n",
    "    print(\"[!] GPU not detected. Go to Runtime > Change runtime type > Select T4 GPU for fast training!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2: Authenticate & Download ODIR-5K Dataset from Kaggle"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import kagglehub\n",
    "\n",
    "# Set Kaggle API Credentials\n",
    "os.environ['KAGGLE_USERNAME'] = \"nishal28\"\n",
    "os.environ['KAGGLE_KEY'] = \"53ef92594ee2bacd60922f65b53c8c05\"\n",
    "\n",
    "print(\"[*] Downloading ODIR-5K Dataset...\")\n",
    "dataset_path = kagglehub.dataset_download(\"andrewmvd/ocular-disease-recognition-odir5k\")\n",
    "print(f\"[OK] Dataset Downloaded to: {dataset_path}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 3: Prepare Patient-Splitting Dataset & PyTorch DataLoaders"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load full dataframe metadata\n",
    "csv_path = os.path.join(dataset_path, \"full_df.csv\")\n",
    "df = pd.read_csv(csv_path)\n",
    "\n",
    "# Extract image paths & labels\n",
    "image_folder = os.path.join(dataset_path, \"preprocessed_images\")\n",
    "\n",
    "records = []\n",
    "for idx, row in df.iterrows():\n",
    "    left_img = os.path.join(image_folder, row['Left-Fundus'])\n",
    "    right_img = os.path.join(image_folder, row['Right-Fundus'])\n",
    "    \n",
    "    # Label: 1 if Cataract, 0 if Normal\n",
    "    is_cataract = 1 if row['Cataract'] == 1 else 0\n",
    "    \n",
    "    if os.path.exists(left_img):\n",
    "        records.append((left_img, is_cataract))\n",
    "    if os.path.exists(right_img):\n",
    "        records.append((right_img, is_cataract))\n",
    "\n",
    "print(f\"[*] Total Validated Eye Images: {len(records)}\")\n",
    "normal_cnt = sum(1 for r in records if r[1] == 0)\n",
    "cat_cnt = sum(1 for r in records if r[1] == 1)\n",
    "print(f"    • Normal Images  : {normal_cnt}")\n",
    "print(f"    • Cataract Images: {cat_cnt}")\n",
    "\n",
    "# Stratified Train / Validation Split (80% Train, 20% Val)\n",
    "train_records, val_records = train_test_split(records, test_size=0.20, random_state=42, stratify=[r[1] for r in records])\n",
    "\n",
    "# PyTorch Custom Dataset Class\n",
    "class OdirCataractDataset(Dataset):\n",
    "    def __init__(self, record_list, transform=None):\n",
    "        self.records = record_list\n",
    "        self.transform = transform\n",
    "        \n",
    "    def __len__(self):\n",
    "        return len(self.records)\n",
    "        \n",
    "    def __getitem__(self, idx):\n",
    "        img_path, label = self.records[idx]\n",
    "        img = Image.open(img_path).convert('RGB')\n",
    "        if self.transform:\n",
    "            img = self.transform(img)\n",
    "        return img, torch.tensor(label, dtype=torch.long)\n",
    "\n",
    "# Data Augmentations\n",
    "train_transforms = transforms.Compose([\n",
    "    transforms.Resize((224, 224)),\n",
    "    transforms.RandomHorizontalFlip(p=0.5),\n",
    "    transforms.RandomRotation(degrees=15),\n",
    "    transforms.ColorJitter(brightness=0.15, contrast=0.15),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "val_transforms = transforms.Compose([\n",
    "    transforms.Resize((224, 224)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "train_loader = DataLoader(OdirCataractDataset(train_records, train_transforms), batch_size=32, shuffle=True, num_workers=2)\n",
    "val_loader = DataLoader(OdirCataractDataset(val_records, val_transforms), batch_size=32, shuffle=False, num_workers=2)\n",
    "\n",
    "print(\"[OK] PyTorch DataLoaders configured successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 4: Build ResNet-50 Transfer Learning Architecture"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_model(num_classes=2):\n",
    "    model = models.resnet50(weights=models.ResNet50_Weights.DEFAULT)\n",
    "    \n",
    "    # Freeze early feature extraction layers\n",
    "    for param in list(model.parameters())[:-15]:\n",
    "        param.requires_grad = False\n",
    "        \n",
    "    # Custom Classification Head\n",
    "    in_features = model.fc.in_features\n",
    "    model.fc = nn.Sequential(\n",
    "        nn.Linear(in_features, 256),\n",
    "        nn.BatchNorm1d(256),\n",
    "        nn.ReLU(),\n",
    "        nn.Dropout(p=0.4),\n",
    "        nn.Linear(256, num_classes)\n",
    "    )\n",
    "    return model\n",
    "\n",
    "model = build_model(num_classes=2).to(device)\n",
    "criterion = nn.CrossEntropyLoss()\n",
    "optimizer = optim.Adam(model.fc.parameters(), lr=1e-4)\n",
    "\n",
    "print(\"[OK] ResNet-50 Neural Network Initialized!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 5: Execute Training Loop (10 Epochs)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "EPOCHS = 10\n",
    "best_val_acc = 0.0\n",
    "\n",
    "for epoch in range(EPOCHS):\n",
    "    model.train()\n",
    "    train_loss, train_correct, total_train = 0.0, 0, 0\n",
    "    \n",
    "    for images, labels in train_loader:\n",
    "        images, labels = images.to(device), labels.to(device)\n",
    "        optimizer.zero_grad()\n",
    "        outputs = model(images)\n",
    "        loss = criterion(outputs, labels)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        \n",
    "        train_loss += loss.item() * images.size(0)\n",
    "        _, preds = torch.max(outputs, 1)\n",
    "        train_correct += torch.sum(preds == labels.data).item()\n",
    "        total_train += labels.size(0)\n",
    "        \n",
    "    # Validation Evaluation\n",
    "    model.eval()\n",
    "    val_loss, val_correct, total_val = 0.0, 0, 0\n",
    "    with torch.no_grad():\n",
    "        for images, labels in val_loader:\n",
    "            images, labels = images.to(device), labels.to(device)\n",
    "            outputs = model(images)\n",
    "            loss = criterion(outputs, labels)\n",
    "            val_loss += loss.item() * images.size(0)\n",
    "            _, preds = torch.max(outputs, 1)\n",
    "            val_correct += torch.sum(preds == labels.data).item()\n",
    "            total_val += labels.size(0)\n",
    "            \n",
    "    train_acc = (train_correct / total_train) * 100.0\n",
    "    val_acc = (val_correct / total_val) * 100.0\n",
    "    \n",
    "    print(f\"Epoch [{epoch+1}/{EPOCHS}] | Train Loss: {train_loss/total_train:.4f} | Train Acc: {train_acc:.2f}% | Val Acc: {val_acc:.2f}%\")\n",
    "    \n",
    "    if val_acc > best_val_acc:\n",
    "        best_val_acc = val_acc\n",
    "        torch.save(model.state_dict(), \"cataract_model_weights.pth\")\n",
    "\n",
    "print(f\"\\n[OK] Training Complete! Best Validation Accuracy: {best_val_acc:.2f}%\")\n",
    "print(\"[OK] Weights saved to 'cataract_model_weights.pth'\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 6: Download Model Weights to Computer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import files\n",
    "print(\"[*] Downloading cataract_model_weights.pth to your computer...\")\n",
    "files.download('cataract_model_weights.pth')"
   ]
  }
